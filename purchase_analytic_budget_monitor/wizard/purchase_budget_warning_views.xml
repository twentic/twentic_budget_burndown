<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_budget_warning_form" model="ir.ui.view">
        <field name="name">purchase.budget.warning.form</field>
        <field name="model">purchase.budget.warning</field>
        <field name="arch" type="xml">
            <form string="Budget Warning">
                <field name="budget_progress" invisible="1"/>
                <div class="alert alert-warning o_form_no_edit" role="alert">
                    <i class="fa fa-exclamation-triangle me-2" title="Budget Warning"/>
                    <field name="warning_message" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <group string="Budget Summary">
                        <field name="purchase_order_id" readonly="1"/>
                        <field name="budget_progress" readonly="1" string="Projected Budget Usage (%)"/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm Order"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-secondary"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
